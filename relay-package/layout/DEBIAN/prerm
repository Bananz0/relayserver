#!/bin/sh
launchctl unload /Library/LaunchDaemons/dev.copper.relayserver.plist 2>/dev/null || true
killall -9 relayserver 2>/dev/null || true
launchctl unload /Library/LaunchDaemons/dev.copper.chargelimit.plist 2>/dev/null || true
# Never leave charging inhibited or the charger input cut behind.
for bin in /usr/local/bin/relay-chargelimit /var/mobile/relay-chargelimit; do
    [ -x "$bin" ] && { "$bin" reset >/dev/null 2>&1; break; }
done
exit 0
